// HX711 circuit wiring
const int LOADCELL_DOUT_PIN =27;
const int LOADCELL_SCK_PIN = 26;

#define SAVEBUTTON_PIN 35
#define TAREBUTTON_PIN 0
#define BUZZER_PIN 25

#define DEFSSID "Gardening, cheaper than therapy"
#define DEFPASSWORD "seeds freedom"
#define DEFMDNS "superscale"

#include "DataManager.h"


class WifiSubMan: public EventListener
{
	DataMap *sconfig;

public:
	bool notify(GenString ename, Event *e){return notify(String(ename.c_str()),e);}
	bool notify(String ename, Event *e){
		StringMapEvent *se=0;
		if(e->isClassType("StringMapEvent")) se=(StringMapEvent *)e;

		if(ename=="/switchToStation") {
			String ssid=se->values["ssid"].c_str(),password=se->values["password"].c_str(),nmdnsname=se->values["mdns"].c_str();
			if(ssid.length()) {
				bool b=WifiMan::connectStation(ssid.c_str(),password.c_str());	// contains delay rather should be called from the main loop
				if(!b) WifiMan::connectAP(WifiMan::apssid.c_str(), WifiMan::appassword.c_str());
			}
			if(nmdnsname!=sconfig->get("mdns")) {sconfig->update("mdns",nmdnsname);}
			//saveSettings();
			return false;
		};
		if(ename=="/switchToAP"){
			String ssid=se->values["ssid"].c_str(),password=se->values["password"].c_str(),nmdnsname=se->values["mdns"].c_str();
			if(ssid.length()) WifiMan::connectAP(ssid.c_str(),password.c_str());	// contains delay rather should be called from the main loop
			if(nmdnsname!=sconfig->get("mdns")) {sconfig->update("mdns",nmdnsname);}
			//	saveSettings();
			return false;
		};
		return false;
	}

	WifiSubMan(DataMap *config0){sconfig=config0;}
	bool connect(){// connect wifi
		//	Serial.println("WifiSubMan::connect");
		bool connected=false;
		if(sconfig->get("mode")=="ST"){
			//		WifiMan::connectStation("Gardening, cheaper than therapy","seeds freedom");
			Serial.println(String()+"Found saved station ssid: "+(*sconfig)["ssid"]);
			connected=WifiMan::connectStation((*sconfig)["ssid"].c_str(), (*sconfig)["password"].c_str());	// try saved ssid
		} else {
			connected=WifiMan::connectStation(DEFSSID,DEFPASSWORD);	// try my ssid
		}
		if(!connected) {	// try ap
			String APname="SuperScale",APpass="";
			if(sconfig->get("mode")=="AP" && sconfig->get("ssid").length()>0) {APname=sconfig->get("ssid");APpass=sconfig->get("password");}
			/*			if(sconfig->exists("apssid")){
				Serial.println(String()+"Found saved apssid:"+sconfig->get("apssid")+" / appassword:"+sconfig->get("appassword"));
				APname=sconfig->get("apssid");APpass=sconfig->get("appassword");}	// try saved AP
			 */			WifiMan::connectAP(APname.c_str(),APpass.c_str());
			 sconfig->update("mode","AP");
		}
		sconfig->update("ip",WifiMan::getIP());
		return connected;
	}
};





class TFTManager : public EventListener{
	SimpleTFT mytft;
	DataMap *map;
public:
	TFTManager(DataMap *map0):map(map0){}
	TFT_eSPI *getTFT(){return mytft.getTFT();}
	bool notify(std::string ename, Event *e){
		/*		if(ename!="weight") {
		//	Serial.println(String()+"TFTManager::notify1 "+ename.c_str());
	//		Serial.println(String()+"TFTManager::notify "+map->getJson());
		}
		 */		//	Serial.println(String()+"TFTManager: notify "+ename.c_str());
		if(ename =="weight" || ename=="block" || ename=="species" || ename=="date" || ename=="totalharvest" || ename=="blockbe" || ename=="history" || ename =="command"){
			//	Serial.println(String()+"TFTManager: notify2 "+ename.c_str());
			if(map->exists(ename.c_str()))
			{		//		Serial.println(String()+"TFT Manager updating screen with "+map->get(ename.c_str())+" for "+ename.c_str());
				String str=map->get(ename.c_str());
				if(ename=="totalharvest" && str.length()>0) str="Tot."+str+"g";
				if(ename=="blockbe" && str.length()>0) str+="% BE";
				if(ename=="weight") str="   "+str+"   ";
				if(ename=="date") str=str.substring(0,str.lastIndexOf("/"));
				if(ename=="command") {str=str.substring(0,21);if(map->get(ename.c_str()).length()>20) str+="..";} // not more than 20 chars
				if(ename!="species" && ename!="date") str=String()+" "+str+" ";
				mytft.setSpotString(ename.c_str(), str);
				//				if(ename!="weight") Serial.println(String()+"TFTManager::notify2 "+ename.c_str()+" "+str.c_str());
				return true;
			}
		}
		return false;
	}
	void redisplay(){mytft.redisplay();}
	void setupTFT() {// f1s1 < f2s1 < f1s2 < f4s1 < f2s2 < f1s3 <f1s4 < f2s3 < f4s2
		mytft.setRotation(4);
		uint16_t titlecolor=0x97F0;
		uint16_t commandcolor=0xFC10;
//		uint16_t argcolor=0xFD40;
		uint16_t blockcolor=0xEC1F;
		uint16_t historycolor=0xFC39;

		int zone1start=0;
		int zone2start=60;
		int zone3start=112;
		bool bg1=true, bg2=true, bg3=true;
		uint16_t bgcolor1=0x1800;// dark red
		uint16_t bgcolor2=0x0004;// dark cyan 		//0x1804;// dark purple
		uint16_t bgcolor3=0x08C0;// dark green 		//0x1804;// dark purple

 		if(bg1) mytft.addRect(Rect(0, zone1start, 135, zone2start-zone1start, bgcolor1));

		//	mytft.setCursor(0, 0);
		mytft.addDisplaySpot("weight");
		mytft.setSpot("weight", DisplaySpot(map->get("weight"), 2, 4,titlecolor,bgcolor1, 4,true,0,68,0));

	 	mytft.addLine(Rect(0, zone2start-1, 135, zone2start-1, 0xA000));
	 	if(bg2) mytft.addRect(Rect(0, zone2start, 135,zone3start-zone2start, bgcolor2));

		mytft.addDisplaySpot("command");
		mytft.setSpot("command", DisplaySpot("", 4, 1,commandcolor,bgcolor2, 8,true,1,0,zone2start));//	mytft.setSpot("command", DisplaySpot("spawn/prep", 4, 1,commandcolor,bgcolor2, 8,true,1,0,zone2start));
//		mytft.addDisplaySpot("argument");
//		mytft.setSpot("argument", DisplaySpot("", 2, 1,argcolor,bgcolor2, 8,true,1,-1,-1)); //	mytft.setSpot("argument", DisplaySpot("pressure co", 1, 2,argcolor,bgcolor2, 8,true,1,-1,-1));

		mytft.addLine(Rect(0, zone3start-2, 135, zone3start-2, TFT_DARKGREEN));
		if(bg3) mytft.addRect(Rect(0, zone3start, 135,240-zone3start, bgcolor3));

		mytft.addDisplaySpot("block");
		mytft.setSpot("block", DisplaySpot("-", 1, 4,blockcolor, bgcolor3, 8,true, 0, 67,zone3start)); // mytft.setSpot("block", DisplaySpot("A111", 1, 4,blockcolor, bgcolor3, 8,true, 0, 67,zone3start));
		mytft.addDisplaySpot("species");
		mytft.setSpot("species", DisplaySpot("", 4, 1,blockcolor, bgcolor3,8,true,0, 40, zone3start+32)); //mytft.setSpot("species", DisplaySpot("LEm", 4, 1,blockcolor, bgcolor3,8,true,0, 40, zone3start+32));
		mytft.addDisplaySpot("date");
		mytft.setSpot("date", DisplaySpot("", 4, 1,blockcolor, bgcolor3,8,true,0, 102, zone3start+32)); // mytft.setSpot("date", DisplaySpot("1.3", 4, 1,blockcolor, bgcolor3,8,true,0, 102, zone3start+32));
		mytft.addDisplaySpot("totalharvest");
		mytft.setSpot("totalharvest", DisplaySpot("", 2, 1,blockcolor, bgcolor3, 8,true,0, 40, zone3start+53));//mytft.setSpot("total", DisplaySpot("Tot. 550g", 2, 1,blockcolor, bgcolor3, 8,true,0, 40, zone3start+53));
		mytft.addDisplaySpot("blockbe");
		mytft.setSpot("blockbe", DisplaySpot("", 2, 1,blockcolor, bgcolor3, 8,true,0, 102, zone3start+53));//mytft.setSpot("blockbe", DisplaySpot("47% BE", 2, 1,blockcolor, bgcolor3, 8,true,0, 102, zone3start+53));

		mytft.addDisplaySpot("history");
		mytft.setSpot("history", DisplaySpot("", 2, 1,historycolor,bgcolor3,8,true,1,0,zone3start+68));//mytft.setSpot("history", DisplaySpot("5/5 harvest 120\n15/4 harvest 300\n3/4 harvest 150\n16/3 harvest 250", 2, 1,historycolor,bgcolor3,8,true,1,0,zone3start+68));

		mytft.display();
		// this should b updted with real values
	}
};



LoadCellReader loadcell(LOADCELL_DOUT_PIN,LOADCELL_SCK_PIN);

DataMap dataset;
WifiSubMan wifisubman=WifiSubMan(&dataset);
DataManager dataman=DataManager(&dataset);
TFTManager tftman(&dataset);
TFTConsole tftconsole=TFTConsole(tftman.getTFT());

BasicServer *server;
Beeper beeper(BUZZER_PIN,false);

Button2 savebutton = Button2(SAVEBUTTON_PIN);
Button2 tarebutton = Button2(TAREBUTTON_PIN);

void buttonsave(Button2& btn){
	Serial.println("Button save callback");
	dataman.saveCurrentCommand();
}

void buttontare(Button2& btn){
	Serial.println("Button tare callback");
	loadcell.tare();
}


// Handle root url (/)
void setup() {
	Serial.begin(115200);
	Serial.println("Setup started");
	SIMPLEFS.begin();
	SIMPLEFS.printInfo();

	dataset.set("ssid",DEFSSID);
	dataset.set("password",DEFPASSWORD);
	dataset.set("mdns",DEFMDNS);

	dataman.init(&beeper);

	tftconsole.display();
	tftconsole.println("Connecting to wifi...");

	wifisubman.connect();
	tftconsole.println("Connected !");

	server=new BasicServer(dataset.get("mdns"));
	server->on("/switchToStation",&wifisubman);
	server->on("/switchToAP",&wifisubman);
	server->on("/json",&dataman);
	server->on("/set",&dataman);
	server->on("/update",&dataman);
	server->on("/load",&dataman);
	server->on("/loadpreset",&dataman);
	server->on("boottime",&dataman);
	server->on("/clearPile",&dataman);
	server->on("/popPile",&dataman);
	server->on("/save",&dataman);
	server->on("/tare",&dataman);
	server->on("/statgroupfilterrequest",&dataman);
	server->on("/statdatafilterrequest",&dataman);

	server->begin();
	tftconsole.println("Server started");
	//	Serial.println("HTTP server started");


	dataset.on("weight", &tftman);
	dataset.on("block", &tftman);
	dataset.on("species", &tftman);
	dataset.on("date", &tftman);
	dataset.on("totalharvest", &tftman);
	dataset.on("blockbe", &tftman);
	dataset.on("history", &tftman);
	dataset.on("command", &tftman);
	dataset.on("argument", &tftman);


	savebutton.setTapHandler(buttonsave);
	tarebutton.setTapHandler(buttontare);

	tftconsole.println("Ready !");
	Serial.println("setup ended");
	// we need a data model
	// that can store :
	// data fields : weight, wifi, selected block info
	// log entries on files : description, substrate, events, harvest
	// interact by
	// provide selected block
	// show its previous history
	// provide selected command or event type
	// attach more events
	// attach basic events
	// auto attach harvest event

	//-> use a data map
	tftman.setupTFT();	// we could print info on wifi trying to connect, or a simple console

	// we need a server
	// provide basic client page : variables and history
	// load qr code (commands into the model)
	//-> start from an esp32 server,
	//-> enrich the client format to support dropdown list and a textarea for history (prototype offline)
}



void loop() {
	beeper.run();
	savebutton.loop();
	tarebutton.loop();
	loadcell.run();
	if (loadcell.hasNewValue()) {
		long l=loadcell.getValue()*1;
		float v=(float)l/(float)1;
		//	Serial.println(String()+"loadcell value :"+v);
		String str=String(v);
		if(str.indexOf(".")>=0) str=str.substring(0,str.indexOf("."));
		if(dataset.get("tare")=="1") {dataset.update("tare","0");loadcell.tare();}
		dataset.update("weight",str);
		tftman.redisplay();
	}
	unsigned long now=millis();
	static unsigned long oldTime=0;
	if( (now - oldTime) > 1000){oldTime=now;Serial.print(".");}
	server->yield();
	WifiMan::reconnectIfNeeded();
	// delay(1000);
}

