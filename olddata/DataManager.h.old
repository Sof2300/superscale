#ifndef DATAMANAGER_H_
#define DATAMANAGER_H_

#define SETBLOCKFREQ 880 //440
#define SETBLOCKLENGTH 400
#define SAVEFREQ 3520
#define SAVELENGTH 400
#define SETFREQ 220
#define SETLENGTH 100

#include "lib/device/Beeper.H"

std::map<String,String> convertMapFromStdString(std::map<std::string,std::string> inmap){
	std::map<String,String> retmap;
	for(auto it : inmap) retmap[it.first.c_str()]=it.second.c_str();
	return retmap;
}




class DataManager: public EventListener {
	DataMap *datamap=0;
	Logger logger;
	Beeper *beeper=0;
	std::map<String,String> presets={{"harvest","harvest:"},{"post-inoculation","species:;date:;spawn:;"},
			{"SDx5.5","substrate/sawdust:1150;substrate/bran:300;substrate/gypsum:45"},
			{"Ftx6","substrate/finetourikis:1260;substrate/bran:330;substrate/gypsum:45"},
			{"FtSDx6","substrate/finetourikis:630;substrate/sawdust:630;substrate/bran:330;substrate/gypsum:45"}
	};
	std::vector<String> nonsavables={"block","commandsaveonload","substrate", "pile", "fifo","pileuse"};

	String pile;
	bool pilegrowing=false;	// true when pile up, false when unpiling

public:
	DataManager(DataMap *sconfig0): datamap(sconfig0) {}
	// on set data
	// 		if command, argument (or multi) -> save a recording
	// 		if block -> lookup & load or create
	// 					test sequence
	// start from create,
	// then save info, save few more commands, then create a new, same thing, then look up first

	void init(Beeper *beeper1=0){
		beeper=beeper1;
		datamap->update("weight","0");
		datamap->update("command","");
		//		datamap->set("argument","");

		datamap->update("block","");
		datamap->update("species","");
		datamap->update("date","");
		datamap->update("commandsaveonload","0");
		datamap->update("infosaveonload","0");
		datamap->update("substratesaveonload","0");
		datamap->update("substrate","");
		datamap->update("numberharvest","");
		datamap->update("totalsubstrate","");
		datamap->update("commandpreset","post-inoculation");
		datamap->update("substratepreset","SDx5.5");
		datamap->update("idlist","");
		datamap->update("flushes","");
		datamap->update("pile","");
		datamap->update("fifo","0");
		datamap->update("pileuse","0");

		datamap->update("statgroupfilterrequest","");
		datamap->update("statdatafilterrequest","");
		datamap->update("statgroupfilterresult","");
		datamap->update("statdatafilterresult","");
		datamap->update("statgroupfiltercompare","");
		datamap->update("statdatafiltercompare","");
		clearBlockInfos();

		logger.init();
		Serial.println(String()+"DataManager::init:  after loggerinit" );
		datamap->update("idlist",logger.getIdList());
		logger.loadStats();
		Serial.println(String()+"DataManager::init:  after loadStats" );
		String stat=logger.getStatResult();
		Serial.println(String()+"DataManager::init:  after stateresult" );
		datamap->update("statresult",stat);
		String stat2=logger.getStatCompare();
		Serial.println(String()+"DataManager::init:  after statecompare" );
		datamap->update("statcompare",stat2);
		Serial.println(String()+"DataManager::init:  after update" );
		/*		presets.set("harvest","harvest:");
		presets.set("post-inoculation","species:;date:;spawn:;");
		presets.set("SDx5.5","substrate/sawdust:1150;substrate/bran:300;substrate/gypsum:45");
		 */

	}



	std::map<String,String> jsonToMap(String str){
		//		Serial.println(String()+"DataManager::jsonToMap:  start" );
		std::vector<String> tab=explode(str,";");
		std::map<String,String> map;
		//		Serial.println(String()+"DataManager::jsonToMap:  tab.size() "+tab.size() );
		for(String v : tab) {
			//			Serial.println(String()+"DataManager::jsonToMap:  v "+v );
			std::vector<String> sub=explode(v, ":");
			String key=sub[0], val=sub[1];
			//			Serial.println(String()+"DataManager::jsonToMap:  key "+key+" val "+val );
			map[key]=val;
		}
		return map;
	}
	String mapToJson(std::map<String,String> map){
		String str;
		for(auto it : map) {
			if(str.length()>0) str+=";";
			str+=String()+it.first+":"+it.second;
		}
		return str;
	}

	void setBlock(String id, bool usepile=true){
		Serial.println(String()+"DataManager::setBlock: set block start" );
		bool b=logger.loadBlock(id);
		datamap->update("block",id);	// update blockid
		clearBlockInfos();
		if(!b) {	// create block by just updating the set and clearing the other values
			Serial.println(String()+"DataManager::setBlock: new block "+datamap->get("block").c_str());
		} else 	updateBlockInfos();
		//		Serial.println(String()+"DataManager::setBlock: datamap->get('commandsaveonload') "+datamap->get("commandsaveonload").c_str());
		if(datamap->get("commandsaveonload")=="1") {	// if checked save command
			String command=datamap->get("command");
			Serial.println(String()+"DataManager::setBlock: command "+command.c_str());
			if(command.length()>0){
				std::map<String, String> map=jsonToMap(command);
				for(auto it : map){
					Serial.println(String()+"DataManager::setBlock: saving "+it.first.c_str()+" "+it.second.c_str());
					if(isSavable(it.first.c_str())) saveEntry(it.first.c_str(),it.second.c_str());
				}
			}
		}
		if(usepile) pileUp();
		if(beeper) beeper->simpleBeep(SETBLOCKFREQ,SETBLOCKLENGTH);
	}

	void updateBlockInfos(){
		BlockInfo bi=logger.getBlockInfo();
		datamap->update("idlist",logger.getIdList());
		datamap->update("history",logger.getHistoryCurrent());
		//		Serial.println(String()+"DataManager::updateBlockInfos history :"+logger.getHistoryCurrent());
		if(bi.totalharvest>0) {
			datamap->update("totalharvest",String((int)bi.totalharvest));
			//			Serial.println(String()+"updated totalharvest with "+logger.getSum("harvest"));
			if(bi.totalsubstrate>0){
				datamap->update("totalsubstrate",String((int)bi.totalsubstrate));
				int be=0;
				be=100.0*bi.totalharvest/bi.totalsubstrate;
				datamap->update("blockbe", String(be).c_str());
			}
		}
		datamap->update("date",bi.date);
		datamap->update("species",bi.species);
		datamap->update("flushes",bi.flushes);

		datamap->update("substrate",logger.getSubstrate());
		//		Serial.println(String()+"DataManager::updateBlockInfos substrate :"+logger.getSubstrate());
	}
	void saveCurrentCommand(){
		String command=datamap->get("command");
		//		Serial.println(String()+"DataManager::saveCurrentCommand : '"+command+"'");
		if(command.length()>0){
			int s=tokenNumber(command,";");
			//			Serial.println(String()+"DataManager::saveCurrentCommand : number '"+s+"'");
			for(int i=0;i<s;i++){
				String sub=getToken(command,";",i);
				//				Serial.println(String()+"DataManager::saveCurrentCommand : sub:"+sub);
				String c=getToken(sub,":",0);
				//				Serial.println(String()+"DataManager::saveCurrentCommand : c:"+c);
				String a=getToken(sub,":",1);
				//				Serial.println(String()+"DataManager::saveCurrentCommand : a:"+a);
				if(c.length()>0) saveEntry(c,a);
			}
		}
	}
	void saveEntry(String command, String argument){
		if(command=="date" && argument=="") argument=getTimeString(true,false);
		if((command=="harvest" || command.indexOf("substrate")>-1) && argument=="") {argument=datamap->get("weight");datamap->update("tare","1");}
		logger.saveEntry(datamap->get("block"), command, argument);
		updateBlockInfos();
		datamap->update("idlist",logger.getIdList());

		Serial.println(String()+"DataManager::saveEntry "+datamap->get("block")+" "+command+" "+argument);
		if(beeper) beeper->simpleBeep(SAVEFREQ,SAVELENGTH);
	}

	void setData(String k, String v){
		datamap->update(k,v);	//update only those exist already, do not add new keys
		if(beeper) beeper->simpleBeep(SETFREQ,SETLENGTH);
		Serial.println(String()+"DataManager::setData updating datamap value "+k+" "+v);
	}

	bool isSavable(String e){
		for(String k : nonsavables) {if(e==k) return false;}
		return true;
	}

	void setPreset(StringMapEvent *se){
		Serial.println(String()+"setPreset : ");
		String commandname="command", presetname="preset";
		for(auto it : se->values){
			String pre=it.first.c_str(),val=it.second.c_str();
			Serial.println(String()+"setPreset : pre:"+pre+" val:"+val);
			if(pre.indexOf(presetname)>-1) {
				presetname=pre;
				if(pre.indexOf("substrate")>-1) {presetname="substratepreset";commandname="substrate";}
				for(auto k : presets) {
					Serial.println(String()+"setPreset : k.first:"+k.first+" val:"+val);
					if(k.first==val) {
						Serial.println(String()+"setPreset : k.first:"+k.first+" k.second:"+k.second);
						datamap->update(commandname,k.second);
						datamap->update(presetname,k.first);}
					if(beeper) beeper->simpleBeep(SETFREQ,SETLENGTH);
				}
			}
		}
	}

	void pileUp(){
		if(datamap->get("block").length()>0 && datamap->get("pileuse")=="1"){	// if pile is active and stacking up, push back current block id
			datamap->get("pile");
			if(pile.length()>0) pile+=",";
			pile+=datamap->get("block");
			datamap->update("pile",pile);
			pilegrowing=true;

		}
	}

	void clearPile(){datamap->update("pile","");pile="";}
	void popPile(){
		pile=datamap->get("pile");
		if(pile.length()>0) {//			Serial.println(String()+"DataManager::setRequest 1 tok"+tok+" pile:"+pile);//		Serial.println(String()+"DataManager::setRequest datamap.get('fifo')"+datamap->get("fifo"));
			String res, tok;
			if(datamap->get("fifo")=="1") {tok=getToken(pile,",",0, &res);pile=res;}
			else {
				//				Serial.println(String()+"DataManager::setRequest 1 tok"+tok+" pile:"+pile);//		Serial.println(String()+"DataManager::setRequest datamap.get('fifo')"+datamap->get("fifo"));
				tok=getLastToken(pile,",",0,&res);
				pile=res;
				//				Serial.println(String()+"DataManager::setRequest 2 tok"+tok+" pile:"+pile+" datamap->get('block'):"+datamap->get("block"));//		Serial.println(String()+"DataManager::setRequest datamap.get('fifo')"+datamap->get("fifo"));
				if(tok==datamap->get("block")) {// here we pop again if current id is the same with popped id and the pile was growing until now (change of direction)
					tok=getLastToken(pile,",",0,&res);
					//pile=res;
					//					Serial.println(String()+"DataManager::setRequest 3 tok"+tok+" pile:"+pile);
				}
			}//			Serial.println(String()+"DataManager::setRequest 2tok"+tok+" pile:"+pile);
			datamap->update("pile",pile);//			Serial.println(String()+"DataManager::setRequest datamap->get(pile)"+datamap->get("pile"));
			setBlock(tok,false);
			pilegrowing=false;
		}
	}

	void unpile(StringMapEvent *se, int pl){
		std::vector<String> toupdate={"pileuse","fifo","pile","pileup"};
		for(String s : toupdate) if(se->exists(s.c_str())) datamap->update(s, se->get(s.c_str()).c_str());
		//		Serial.println(String()+"DataManager::setRequest pl"+pl+" !se->exists('pile')"+!se->exists("pile")+" datamap.get('pileuse'):"+datamap->get("pileuse"));
		if(pl>0 && !se->exists("pile") && datamap->get("pileuse")=="1") popPile();
	}

	void setRequest(StringMapEvent *se){
		// when we get a set request :
		for(auto it=se->values.begin();it!=se->values.end();it++){	// go through request arguments
			String arg=it->second.c_str();
			if(datamap->exists(it->first.c_str())) {
				setData(it->first.c_str(),arg);	//update only those exist already, do not add new keys
				Serial.println (String()+"Datamanager::setRequest set :"+it->first.c_str()+" "+arg);
			}
		}

	}

	void saveRequest(StringMapEvent *se){
		String savedvar="command";//	- to know what command we execute, we need to see which of saveonload variables is there, substrate, info or command
		//		String keyonload="commandsaveonload";
		//		String valueonload=se->get(keyonload.c_str());
		//		datamap->update(keyonload, valueonload);

		//	- we will pack the command/args and store them in the appropriate variable in datamap
		String packed;
		for(auto it=se->values.begin();it!=se->values.end();it++){
			Serial.println(String()+"DataManager::setRequest key:"+it->first.c_str());
			if(isSavable(it->first.c_str())){
				if(packed.length()>0) packed+=";";
				packed+=String()+it->first.c_str()+":"+it->second.c_str();}
		}
		if(savedvar.length()>0 && packed.length()>0) setData(savedvar, packed);

		if(datamap->get("commandsaveonload")=="0") updateRequest(se);

		//	Serial.println(String()+"DataManager::setRequest savedvar:"+savedvar+" se->get((savedvar+'saveonload').c_str()):"+se->get((savedvar+"saveonload").c_str()));
		//		if(valueonload=="0" && datamap->get("block").length()>0 && packed.length()>0)//	- if got a 0 for saveonload we will also save an entry
		//			for(auto it=se->values.begin();it!=se->values.end();it++)
		//				if(isSavable(it->first.c_str())) saveEntry(it->first.c_str(),it->second.c_str());
		//		Serial.println(String()+"packed"+packed);
		unpile(se, packed.length());
	}

	void updateRequest(StringMapEvent *se){
		logger.cancelSubstrate(convertMapFromStdString(se->values));
		Serial.println (String()+"Datamanager::updateRequest set update");
		if(datamap->get("block").length()>0) {
			for(auto it=se->values.begin();it!=se->values.end();it++){	// go through request arguments
				String arg=it->second.c_str();
				if(isSavable(it->first.c_str())) saveEntry(it->first.c_str(),arg);
			}
		}
	}

	/*
		if(datamap->get("block").length()>0) {
			if(se->exists("command")){	// if request arguments contain command
				String argument=se->get("argument");
				String command=se->get("command");
