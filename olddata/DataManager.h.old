					}
				}
			}
		}*/
	void statgroupfilterupdate(String val){
		datamap->update("statgroupfilterrequest",val);
		logger.updateStatGroupFilter(val);
		String res=logger.getStatResult();
		datamap->update("statgroupfilterresult",res);
		String comp=logger.getStatCompare();
		datamap->update("statgroupfiltercompare",comp);
		logger.clearStatGroupFilters();	// should we really remove them here or next time or some other way ?
		//groupfilter=val;
	}
	void statdatafilterupdate(String val){
		Serial.println(String()+"DataManager:statdatafilterupdate val:"+val);
		//datafilter=val;
		datamap->update("datafilter",val);
		logger.updateStatDataFilter(val);
		StatAnalyzer statan2;
		statan2.init();
		statan2.addDataFilter(val);
		logger.loadStats(&statan2);	//statan2.calculate();
		String restablestatus=statan2.getStatusTable();
		datamap->update("statdatafilterresult",restablestatus);
		Serial.println(String()+"teststat:: restablestatus:"+restablestatus);
		String restablecompare=statan2.getStatusCompare();
		datamap->update("statdatafiltercompare",restablecompare);
		Serial.println(String()+"teststat:: restablecompare:"+restablecompare);
		Serial.println(String()+"DataManager:statdatafilterupdate end val:"+val);
	}


	bool notify(GenString ename, Event *e){return notify(String(ename.c_str()),e);}
	bool notify(String ename, Event *e){
		//	Serial.println(String()+"DataManager:notify ename:"+ename);
		if(ename[ename.length()-1]=='/') ename=ename.substring(0,ename.length()-1);
		StringMapEvent *se=0;
		if(e->isClassType("StringMapEvent")) se=(StringMapEvent *)e;
		if(datamap==0 || se==0) return false;
		if(ename==String("/json")) {se->insertValue("response",datamap->getJson({"password","stpassword","appassword","tare"}).c_str());return true;}
		if(ename==String("/tare")) {datamap->update("tare","1");se->insertValue("response","OK");return true;}
		if(ename==String("/load")) {
			for(auto it=se->values.begin();it!=se->values.end();it++){
				Serial.println(String()+"DataListener::notify loading value "+String(it->first.c_str())+" "+String(it->second.c_str()));
				if(it->first=="block" && it->second.size()>0) setBlock(it->second.c_str());
			}
			se->insertValue("type","text/html");
			se->insertValue("response","<html><meta http-equiv=\"Refresh\" content=\"0; url='/'\" /></html>");
			return true;
		}

		if(ename==String("/statgroupfilterrequest") && se->exists("statgroupfilterrequest"))
		{statgroupfilterupdate(se->get("statgroupfilterrequest"));se->insertValue("response","OK");return true;}
		if(ename==String("/statdatafilterrequest") && se->exists("statdatafilterrequest")) {
			statdatafilterupdate(se->get("statdatafilterrequest"));se->insertValue("response","OK");return true;}

		if(ename==String("/clearPile")) {clearPile();se->insertValue("response","OK");return true;}
		if(ename==String("/popPile")) {popPile();se->insertValue("response","OK");return true;}
		if(ename==String("/save")) {saveRequest(se);se->insertValue("response","OK");return true;}

		if(ename==String("/loadpreset")) {setPreset(se);se->insertValue("response","OK");return true;}
		if(ename==String("/set")) {
			setRequest(se);// maybe this class should only modify model, and this trigger another class to autofill by loading or save an entry// this would mean another variable that would be tosave//		se->insertValue("type","text/html");
			se->insertValue("response","OK");	// what is this ok used to ? dont remember
			return true;
		}
		// to save substrate we need to cancel each substrate that is in the history and not in the new command
		if(ename==String("/update")) {
			updateRequest(se);
			se->insertValue("response","OK");	// what is this ok used to ? dont remember
			return true;
		}
		if(ename=="boottime"){
			String str=se->get("boottime").c_str();
			boottime=str.toInt();
			Serial.println(String()+"Datamanager updated boottime "+boottime+" str:"+str);
		}
		return false;
	}

	void clearBlockInfos(){
		//datamap->set("block","");
		datamap->update("species","");
		datamap->update("date","");
		datamap->update("inoculationdate","");
		//	datamap->set("extratags","");
		datamap->update("history","");
		datamap->update("blockbe","");
		datamap->update("totalharvest","0");
		datamap->update("totalsubstrate","0");
	}


};


#endif /* DATAMANAGER_H_ */
